GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://127.0.0.1:8787/auth/callback
APP_ORIGIN=http://127.0.0.1:8787
PORT=8787
# Optional local-only AI assistance for ambiguous emails.
# Start Ollama and install the model first: ollama run qwen3:4b
LOCAL_AI_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# Optional override; defaults to ~/Library/Application Support/Job Inbox
# JOB_INBOX_DATA_DIR=/an/absolute/local/path
